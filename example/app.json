{
  "expo": {
    "name": "Motionary",
    "slug": "motionary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "continuedtask.example",
      "deploymentTarget": "15.1",
      "appleTeamId": "SWB36HXMK2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "continuedtask.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-continued-task",
        {
          "identifierPrefixes": [
            "continuedtask.example.export",
            "continuedtask.example.render"
          ],
          "enableGPU": false,
          "androidForegroundServiceTypes": [
            "dataSync"
          ]
        }
      ],
      "./plugins/withNotificationIcon"
    ]
  }
}
