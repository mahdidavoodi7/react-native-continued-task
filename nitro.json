{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["continuedtask"],
  "ios": {
    "iosModuleName": "ContinuedTask"
  },
  "android": {
    "androidNamespace": ["continuedtask"],
    "androidCxxLibName": "continuedtask"
  },
  "autolinking": {
    "ContinuedTaskManager": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridContinuedTaskManager"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridContinuedTaskManager"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
