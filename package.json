{
  "name": "react-native-continued-task",
  "version": "0.1.0",
  "description": "Run user-initiated work that keeps going in the background: iOS 26 BGContinuedProcessingTask and Android WorkManager foreground services behind one API. A free package from https://motionary.dev",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-continued-task-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "plugin/build",
    "app.plugin.js",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!android/src/test",
    "!android/src/androidTest"
  ],
  "scripts": {
    "example": "yarn workspace react-native-continued-task-example",
    "clean": "del-cli lib plugin/build",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "build:plugin": "tsc --build plugin",
    "harness": "EXPO_PUBLIC_RN_HARNESS=1 harness --config jest.harness.config.mjs",
    "harness:android": "EXPO_PUBLIC_RN_HARNESS=1 harness --config jest.harness.config.mjs --harnessRunner android",
    "harness:ios": "EXPO_PUBLIC_RN_HARNESS=1 harness --config jest.harness.config.mjs --harnessRunner ios"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "expo",
    "nitro",
    "nitro-modules",
    "background",
    "background-task",
    "bgcontinuedprocessingtask",
    "workmanager",
    "foreground-service",
    "live-activity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdidavoodi7/react-native-continued-task.git"
  },
  "author": "Mehdi Davoodi <mahdidavoodi7@gmail.com> (https://github.com/mahdidavoodi7)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mahdidavoodi7/react-native-continued-task/issues"
  },
  "homepage": "https://motionary.dev?utm_source=npm&utm_medium=package",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "~55.0.0",
    "@react-native-harness/platform-android": "1.4.1",
    "@react-native-harness/platform-apple": "1.4.1",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.0.0",
    "nitrogen": "0.37.1",
    "prettier": "^3.8.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.41.0",
    "react-native-harness": "1.4.1",
    "react-native-nitro-modules": "0.37.1",
    "ts-jest": "^29.4.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  }
}
